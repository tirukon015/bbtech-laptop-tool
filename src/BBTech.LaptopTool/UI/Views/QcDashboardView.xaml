<UserControl x:Class="BBTech.LaptopTool.UI.Views.QcDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="QcCardBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Width" Value="232" />
            <Setter Property="MinHeight" Value="170" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="24,20,24,28">
                <!-- Device Header -->
                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="{StaticResource NeutralSoft}" CornerRadius="4" Padding="7,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="QUALITY CONTROL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" />
                                </Border>
                                <TextBlock x:Name="DeviceTitle" Text="Identifying laptop hardware..." FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock x:Name="DeviceSpecs" Text="Detecting CPU, RAM, storage and serial number..." Style="{StaticResource Muted}" FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource BaseButton}" Click="Rescan_Click" Padding="12,6" MinHeight="32" ToolTip="Re-scan laptop">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                <TextBlock Text="Rescan" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <ContentControl x:Name="LifecycleHost" Margin="0,0,0,16" Focusable="False" />

                <!-- Hardware Results Handoff Banner -->
                <Border x:Name="HwHandoffBox" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,14" Background="{StaticResource PassSoft}" BorderBrush="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="6" Background="White" Margin="0,0,12,0" VerticalAlignment="Center" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                                <TextBlock x:Name="HwHandoffIcon" FontFamily="{StaticResource IconFont}" Text="&#xE73E;" FontSize="16" Foreground="{StaticResource PassBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="HwStatusHeading" Text="Checking preparation results..." FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock x:Name="HwStatusDetail" Text="Reading the Hardware and Software results for this laptop..." Style="{StaticResource Muted}" FontSize="12" />
                            </StackPanel>
                            <Button x:Name="ToggleHwResultsBtn" Grid.Column="2" Style="{StaticResource BaseButton}" Content="View details"
                                    Click="ToggleHwResults_Click" Padding="12,6" MinHeight="30" FontSize="12" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Expandable Hardware Results Breakdown -->
                        <Border x:Name="HwResultsPanel" Visibility="Collapsed" Background="White" CornerRadius="6" Padding="14,10" Margin="0,10,0,0" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                            <StackPanel x:Name="HwResultsList" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- QC Inspection Checklist Header -->
                <DockPanel Margin="4,0,4,10" LastChildFill="True">
                    <TextBlock x:Name="QcProgressText" DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="QC Inspection Checklist" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0" />
                </DockPanel>

                <!-- QC Cards Grid -->
                <WrapPanel x:Name="CardsContainer" Margin="-6,0" />

                <!-- Final QC Decision Card -->
                <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,18,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="FINAL QUALITY CONTROL VERIFICATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                            <TextBlock x:Name="FinalSummaryText" Text="Review hardware results and complete the QC checklist above." FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock x:Name="FinalLastResultText" Text="No final QC decision recorded for this session yet." Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="FinalFailBtn" Style="{StaticResource FailButton}" Content="QC FAIL" Click="FinalFail_Click" Margin="0,0,10,0" MinWidth="130" Height="42" FontSize="14" FontWeight="Bold" />
                            <Button x:Name="FinalPassBtn" Style="{StaticResource PassButton}" Content="QC PASS" Click="FinalPass_Click" MinWidth="130" Height="42" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                    </Grid>
                </Border>
                <ContentControl x:Name="DeliveryHost" Margin="0,18,0,0" Focusable="False" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
