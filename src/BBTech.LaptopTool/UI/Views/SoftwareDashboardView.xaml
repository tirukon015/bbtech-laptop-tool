<UserControl x:Class="BBTech.LaptopTool.UI.Views.SoftwareDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SoftwareCardBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Width" Value="232" />
            <Setter Property="MinHeight" Value="160" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="24,20,24,32">
                <!-- Top Identity Strip -->
                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="{StaticResource NeutralSoft}" CornerRadius="4" Padding="7,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="SOFTWARE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" />
                                </Border>
                                <TextBlock x:Name="DeviceTitle" Text="Identifying laptop hardware..." FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock x:Name="DeviceSpecs" Text="Detecting CPU, RAM, storage and operating system..." Style="{StaticResource Muted}" FontSize="12" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource BaseButton}" Click="Rescan_Click" Padding="12,6" MinHeight="32" ToolTip="Refresh software status and device specs">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                    <TextBlock Text="Rescan" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ContentControl x:Name="LifecycleHost" Margin="0,0,0,16" Focusable="False" />

                <ContentControl x:Name="WindowsHost" Margin="0,0,0,16" Focusable="False" />

                <!-- SECTION 1: DEVICE TESTS -->
                <DockPanel Margin="4,0,4,10" LastChildFill="True">
                    <TextBlock x:Name="TestSummaryText" DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="DEVICE TESTS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                </DockPanel>

                <!-- 6 Visual Software Diagnostic Cards -->
                <WrapPanel x:Name="TestCardsContainer" Margin="-6,0,0,20" />

                <!-- SECTION 2: MICROSOFT OFFICE -->
                <TextBlock Text="MICROSOFT OFFICE" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="4,0,0,10" />
                <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,18">
                    <StackPanel>
                        <!-- Header & Badges -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Microsoft Office" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                <Border x:Name="OfficeInstallBadge" CornerRadius="4" Padding="7,2" Margin="10,0,0,0" Background="{StaticResource NeutralSoft}">
                                    <TextBlock x:Name="OfficeInstallBadgeText" Text="Checking..." FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource NeutralBrush}" />
                                </Border>
                                <Border x:Name="OfficeActivationBadge" CornerRadius="4" Padding="7,2" Margin="6,0,0,0" Background="{StaticResource NeutralSoft}">
                                    <TextBlock x:Name="OfficeActivationBadgeText" Text="Checking..." FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource NeutralBrush}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Installation Section -->
                        <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Installation" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock x:Name="OfficeDetailsText" Text="Checking installation status..." Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource BaseButton}" Content="Check Install" Click="CheckOfficeInstall_Click" Padding="12,6" MinHeight="34" Margin="0,0,8,0" />
                                    <Button x:Name="InstallOfficeBtn" Style="{StaticResource PrimaryButton}" Content="INSTALL" Click="InstallOffice_Click" MinWidth="110" Height="34" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Activation Section -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Activation" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock x:Name="OfficeActivationDetailsText" Text="Verifying Microsoft Office license status..." Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource BaseButton}" Content="CHECK ACTIVATION" Click="CheckOfficeActivation_Click" Padding="12,6" MinHeight="34" Margin="0,0,8,0" />
                                <Button x:Name="ActivateOfficeBtn" Style="{StaticResource PrimaryButton}" Content="ACTIVATE" Click="ActivateOffice_Click" MinWidth="110" Height="34" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 3: WINDOWS ACTIVATION -->
                <TextBlock Text="WINDOWS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="4,0,0,10" />
                <Border Style="{StaticResource Card}" Padding="20,16">
                    <StackPanel>
                        <!-- Header & Badges -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="WindowsEditionText" Text="Windows 11 Pro" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                <Border x:Name="WindowsActivationBadge" CornerRadius="4" Padding="7,2" Margin="10,0,0,0" Background="{StaticResource NeutralSoft}">
                                    <TextBlock x:Name="WindowsActivationBadgeText" Text="Checking..." FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource NeutralBrush}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Activation Section -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Activation" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock x:Name="WindowsDetailsText" Text="Verifying permanent digital license and activation status..." Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource BaseButton}" Content="CHECK ACTIVATION" Click="CheckWindowsActivation_Click" Padding="12,6" MinHeight="34" Margin="0,0,8,0" />
                                <Button x:Name="ActivateWindowsBtn" Style="{StaticResource PrimaryButton}" Content="ACTIVATE" Click="ActivateWindows_Click" MinWidth="110" Height="34" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
