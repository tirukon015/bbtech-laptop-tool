<UserControl x:Class="BBTech.LaptopTool.UI.Views.TestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- One test row (used for the Required and the Additional sections). -->
        <DataTemplate x:Key="TestRow">
            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="150" MaxWidth="260" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="124" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                            <Border x:Name="ReqTag" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center" Background="{StaticResource BrandSoft}" Visibility="Collapsed">
                                <TextBlock Text="REQUIRED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brand}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Notes}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Notes}" MaxHeight="40" />
                    <Border Grid.Column="2" CornerRadius="6" Padding="10,6" HorizontalAlignment="Left" VerticalAlignment="Center" MinWidth="108"
                            Background="{Binding State, Converter={StaticResource StateBg}}">
                        <TextBlock Text="{Binding StateLabel}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{Binding State, Converter={StaticResource StateFg}}" />
                    </Border>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="RemoveButton" Style="{StaticResource LinkButton}" Content="Remove" Click="Remove_Click" Tag="{Binding}" Margin="0,0,2,0" FontSize="12"
                                ToolTip="Remove this test from the inspection (it will not be counted)" />
                        <Button Style="{StaticResource LinkButton}" Content="Reset" Click="Reset_Click" Tag="{Binding}" Margin="0,0,6,0" FontSize="12" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Run test" Click="Run_Click" Tag="{Binding}" MinWidth="110" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Mandatory}" Value="True">
                    <Setter TargetName="RemoveButton" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ReqTag" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,14,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: operator, device, inspection, overall -->
        <DockPanel LastChildFill="True" Margin="0,0,0,8">
            <Border x:Name="OverallBadge" DockPanel.Dock="Right" CornerRadius="10" Padding="16,6" MinWidth="190" Margin="12,0,0,0" VerticalAlignment="Top">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="OVERALL RESULT" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Opacity="0.8" x:Name="OverallCaption" />
                    <TextBlock x:Name="OverallText" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="OverallSub" FontSize="12" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="Hardware tests" Style="{StaticResource H1}" Margin="0,0,20,4" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="TESTED BY" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="OperatorBox" MinWidth="180" FontSize="15" Padding="8,5" Focusable="False" AutomationProperties.Name="Tested By"
                                  DisplayMemberPath="Name" SelectionChanged="Operator_Changed" />
                        <TextBlock x:Name="RoleText" FontSize="13" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </WrapPanel>
                <TextBlock x:Name="DeviceText" Style="{StaticResource Muted}" Text="Identifying laptop..." />
                <TextBlock x:Name="InspectionText" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brand}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Storage / identity notice -->
        <Border x:Name="Banner" Grid.Row="1" Visibility="Collapsed" CornerRadius="8" Padding="14,8" Margin="0,0,0,8" Background="{StaticResource WarnSoft}">
            <TextBlock x:Name="BannerText" Foreground="#7A4A00" FontSize="13" TextWrapping="Wrap" />
        </Border>

        <!-- Test mode -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
            <DockPanel LastChildFill="True">
                <Button x:Name="AddTestsButton" DockPanel.Dock="Right" Style="{StaticResource BaseButton}" Click="AddTests_Click" AutomationProperties.Name="Add Tests"
                        ToolTip="Add more tests to this inspection">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Add Tests" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="TEST MODE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button x:Name="ModeRequiredButton" Style="{StaticResource ModeButton}" Content="REQUIRED" Click="ModeRequired_Click" AutomationProperties.Name="REQUIRED"
                            ToolTip="Display, Sound, Keyboard and Battery (you can add more tests)" />
                    <Button x:Name="ModeAllButton" Style="{StaticResource ModeButton}" Content="ALL TESTS" Click="ModeAll_Click" AutomationProperties.Name="ALL TESTS"
                            ToolTip="Every available test" />
                    <TextBlock x:Name="ModeSummary" FontSize="13" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="4,0,12,0" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
                <TextBlock x:Name="RequiredHeader" Text="Required tests" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="2,0,0,6" />
                <ItemsControl x:Name="RequiredList" ItemTemplate="{StaticResource TestRow}" />
                <TextBlock x:Name="AdditionalHeader" Text="Additional tests" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="2,8,0,6" />
                <ItemsControl x:Name="AdditionalList" ItemTemplate="{StaticResource TestRow}" />
                <TextBlock x:Name="AdditionalEmpty" Style="{StaticResource Muted}" Margin="2,0,0,8"
                           Text="No additional tests selected. Use “+ Add Tests” to include Camera, Microphone, Touchpad, USB, Wi-Fi, Bluetooth, Storage, Headphone…" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource BaseButton}" Content="Start over" Click="StartOver_Click"
                    ToolTip="Close the current inspection (kept in history as abandoned) and start a new one" />
            <TextBlock x:Name="SavedText" Grid.Column="1" VerticalAlignment="Center" Margin="12,0" Foreground="{StaticResource PassBrush}" FontWeight="SemiBold"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource LinkButton}" Content="Export CSV" Click="SaveCsv_Click" Margin="0,0,4,0" />
                <Button Style="{StaticResource LinkButton}" Content="Export JSON" Click="SaveJson_Click" Margin="0,0,10,0" />
                <Button x:Name="CompleteButton" Style="{StaticResource PassButton}" Content="COMPLETE INSPECTION" Click="Complete_Click" MinWidth="200"
                        AutomationProperties.Name="Complete Inspection" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
