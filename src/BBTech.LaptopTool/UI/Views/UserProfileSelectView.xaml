<UserControl x:Class="BBTech.LaptopTool.UI.Views.UserProfileSelectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="OperatorComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,32" MaxWidth="520">
                <!-- Focused Operator Identification Card -->
                <Border Style="{StaticResource Card}" Padding="32,28">
                    <StackPanel>
                        <!-- Top Icon & Header -->
                        <Border Width="48" Height="48" CornerRadius="10" Background="{StaticResource NeutralSoft}" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE77B;" FontSize="22" Foreground="{StaticResource TextPrimary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="Who are you?" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                        <TextBlock Text="Select your operator account to begin testing. Assigned departments and security permissions will load automatically."
                                   Style="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,24" TextAlignment="Center" TextWrapping="Wrap" />

                        <!-- Searchable Operator Dropdown / ComboBox -->
                        <TextBlock Text="OPERATOR ACCOUNT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="2,0,0,6" />
                        <ComboBox x:Name="OperatorComboBox" Style="{StaticResource OperatorComboBoxStyle}"
                                  IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                                  SelectionChanged="OperatorComboBox_SelectionChanged" KeyDown="OperatorComboBox_KeyDown">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="4,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimary}" />
                                                <TextBlock Text="{Binding Role}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,1,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{StaticResource NeutralSoft}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding DepartmentSummary}" FontSize="10" Foreground="{StaticResource TextMuted}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Error or Notice message -->
                        <TextBlock x:Name="NoticeText" Foreground="{StaticResource FailBrush}" FontSize="12" Margin="2,8,0,0" Visibility="Collapsed" />

                        <!-- Action Button -->
                        <Button x:Name="ContinueButton" Style="{StaticResource PrimaryButton}" Height="46" Margin="0,20,0,0"
                                Click="ContinueButton_Click" IsDefault="True">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Continue" FontWeight="Bold" FontSize="14" Foreground="White" VerticalAlignment="Center" />
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE76C;" FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
