<UserControl x:Class="BBTech.LaptopTool.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="BigAction" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Width" Value="340" />
            <Setter Property="Height" Value="250" />
            <Setter Property="Margin" Value="14" />
            <Setter Property="Padding" Value="24,22" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2"
                                CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.10" Color="#0A2A7A" />
                            </Border.Effect>
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brand}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrandSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Designed at ~760×560; scales DOWN uniformly on small or highly scaled screens
             (e.g. 1366×768 at 150%), never up, so nothing is clipped or overlapping. -->
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="16,12">
            <StackPanel HorizontalAlignment="Center">
                <Image x:Name="HomeLogo" Source="/Assets/Branding/logo-tile-256.png" Width="150" Height="150" HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="BBTech Laptop Tool logo" />
                <TextBlock Text="BBTech Laptop Tool" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"
                           Foreground="{StaticResource Navy}" TextWrapping="NoWrap" />
                <TextBlock Text="Choose what you want to do" FontSize="16" HorizontalAlignment="Center" Margin="0,4,0,10"
                           Foreground="{StaticResource TextMuted}" TextWrapping="NoWrap" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource BigAction}" Click="Detect_Click" AutomationProperties.Name="DETECT"
                            ToolTip="Identify brand, model, CPU, RAM, storage and battery health">
                        <StackPanel>
                            <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource BrandSoft}" HorizontalAlignment="Left">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" FontSize="28" Foreground="{StaticResource Brand}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="DETECT" FontSize="32" FontWeight="Bold" Margin="0,18,0,4" Foreground="{StaticResource Navy}" />
                            <TextBlock Text="Detect laptop + previous QC history" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Brand}" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="13"
                                       Text="Brand, model, model number, CPU, generation, RAM, storage and battery health for ITMS." />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource BigAction}" Click="Test_Click" AutomationProperties.Name="TEST"
                            ToolTip="Run individual hardware tests">
                        <StackPanel>
                            <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource TealSoft}" HorizontalAlignment="Left">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9D9;" FontSize="28" Foreground="{StaticResource Teal}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="TEST" FontSize="32" FontWeight="Bold" Margin="0,18,0,4" Foreground="{StaticResource Navy}" />
                            <TextBlock Text="Perform QC inspection" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Teal}" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="13"
                                       Text="Display, keyboard, touchpad, audio, camera, USB, Wi-Fi, Bluetooth, battery and storage." />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Wi-Fi is a small utility: deliberately smaller than the two primary workflows. -->
                <Button Style="{StaticResource BaseButton}" Click="Wifi_Click" AutomationProperties.Name="Wi-Fi" HorizontalAlignment="Center"
                        Margin="0,4,0,0" Padding="18,8" ToolTip="Install BBTech Wi-Fi on this laptop (automatic connection)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE701;" FontSize="16" Foreground="{StaticResource Cyan}" VerticalAlignment="Center" />
                        <TextBlock Text="Wi-Fi" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="  ·  Quick BBTech Wi-Fi utility" Foreground="{StaticResource TextMuted}" FontWeight="Normal" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Viewbox>

        <Grid Grid.Row="1" Margin="20,0,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource LinkButton}" Content="Settings" FontSize="12" Click="Settings_Click" />
                <Button Style="{StaticResource LinkButton}" Content="Exported files" FontSize="12" Click="Data_Click" />
                <Button Style="{StaticResource LinkButton}" Content="About" FontSize="12" Click="About_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

