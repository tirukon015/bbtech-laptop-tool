<UserControl x:Class="BBTech.LaptopTool.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StartTestingBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Width" Value="380" />
            <Setter Property="Height" Value="64" />
            <Setter Property="Background" Value="{StaticResource TextPrimary}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="20,12">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="8" Background="#1E293B" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" FontSize="16" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="START TESTING" FontSize="15" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Text="Select operator &amp; begin workflow" FontSize="11" Foreground="#94A3B8" Margin="0,1,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" FontFamily="{StaticResource IconFont}" Text="&#xE76C;" FontSize="14" Foreground="#64748B" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E293B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryUtilityBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Width" Value="182" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="12,8">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1" />
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24,20">
            <StackPanel HorizontalAlignment="Center" MaxWidth="600">
                <Image x:Name="HomeLogo" Source="/Assets/Branding/logo-tile-256.png" Width="68" Height="68" HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="BBTech Laptop Tool logo" Margin="0,0,0,16" />

                <TextBlock Text="BBTech Laptop Tool" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextPrimary}" TextWrapping="NoWrap" />
                <TextBlock Text="Prepare. Test. Verify." FontSize="15" HorizontalAlignment="Center" Margin="0,6,0,28"
                           Foreground="{StaticResource TextMuted}" TextWrapping="NoWrap" />

                <!-- Primary Action: START TESTING -->
                <Button Style="{StaticResource StartTestingBtn}" Click="StartTesting_Click" AutomationProperties.Name="Start Testing"
                        HorizontalAlignment="Center" Margin="0,0,0,18" />

                <!-- Secondary Utilities -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource SecondaryUtilityBtn}" Click="Detect_Click" ToolTip="Inspect hardware specifications, copy details, or export">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" FontSize="14" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                            <TextBlock Text="Detect Specs" FontWeight="SemiBold" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryUtilityBtn}" Click="Wifi_Click" ToolTip="Provision network connectivity">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE701;" FontSize="14" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                            <TextBlock Text="Wi-Fi Utility" FontWeight="SemiBold" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Viewbox>

        <!-- Clean Footer -->
        <Border Grid.Row="1" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Background="White" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource LinkButton}" Content="Settings" FontSize="12" Click="Settings_Click" />
                    <TextBlock Text="·" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="4,0" />
                    <Button Style="{StaticResource LinkButton}" Content="Exported Files" FontSize="12" Click="Data_Click" />
                    <TextBlock Text="·" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="4,0" />
                    <Button Style="{StaticResource LinkButton}" Content="About" FontSize="12" Click="About_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
