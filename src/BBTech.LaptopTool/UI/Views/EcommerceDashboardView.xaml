<UserControl x:Class="BBTech.LaptopTool.UI.Views.EcommerceDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BBTech.LaptopTool.UI.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- E-Commerce Header Badge -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="20,12">
            <DockPanel>
                <Border DockPanel.Dock="Left" Background="{StaticResource NeutralSoft}" CornerRadius="4" Padding="7,2" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="E-COMMERCE" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                </Border>
                <TextBlock Text="Laptop Specification Intake, Full Name Listing &amp; ITMS Integration" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Detect / Intake View -->
        <views:DetectView x:Name="DetectViewInstance" Grid.Row="1" />
    </Grid>
</UserControl>
