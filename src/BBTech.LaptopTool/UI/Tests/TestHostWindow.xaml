<Window x:Class="BBTech.LaptopTool.UI.Tests.TestHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="700" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}" FontFamily="Segoe UI" Foreground="{StaticResource TextPrimary}" ShowInTaskbar="False"
        Icon="/Assets/bbtech.ico" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="20,12">
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource H1}" FontSize="22" />
                <TextBlock x:Name="InstructionsText" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <ContentControl x:Name="PanelHost" Grid.Row="1" Margin="18,12" Focusable="False" />

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border x:Name="SuggestionBox" CornerRadius="6" Padding="10,6" HorizontalAlignment="Left" Visibility="Collapsed">
                        <TextBlock x:Name="SuggestionText" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                    </Border>
                    <DockPanel x:Name="CommentRow" Margin="0,6,0,0">
                        <TextBlock Text="Comment (optional):" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left" />
                        <TextBox x:Name="CommentBox" MaxLength="200" FontSize="13" Padding="6,4" VerticalContentAlignment="Center" />
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource LinkButton}" Content="Close (no result)" Click="Cancel_Click" Margin="0,0,8,0" AutomationProperties.Name="Close without result" />
                    <Button Style="{StaticResource BaseButton}" Content="SKIP" Click="Skip_Click" Margin="0,0,8,0" MinWidth="90" />
                    <Button Style="{StaticResource FailButton}" Content="FAIL" Click="Fail_Click" Margin="0,0,8,0" />
                    <Button Style="{StaticResource PassButton}" Content="PASS" Click="Pass_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>


