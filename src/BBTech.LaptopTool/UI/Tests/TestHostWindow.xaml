<Window x:Class="BBTech.LaptopTool.UI.Tests.TestHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="740" MinHeight="440" WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}" FontFamily="Segoe UI" Foreground="{StaticResource TextPrimary}" ShowInTaskbar="False"
        Icon="/Assets/bbtech.ico" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="24,14">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                <TextBlock x:Name="InstructionsText" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Test Interactive Surface -->
        <ContentControl x:Name="PanelHost" Grid.Row="1" Margin="20,14" Focusable="False" />

        <!-- Bottom Decision Strip -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <Border x:Name="SuggestionBox" CornerRadius="6" Padding="10,5" HorizontalAlignment="Left" Visibility="Collapsed">
                        <TextBlock x:Name="SuggestionText" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                    </Border>
                    <DockPanel x:Name="CommentRow" Margin="0,6,0,0">
                        <TextBlock Text="Notes (optional):" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" DockPanel.Dock="Left" FontSize="12" />
                        <TextBox x:Name="CommentBox" MaxLength="200" FontSize="12" Padding="8,5" VerticalContentAlignment="Center"
                                 BorderBrush="{StaticResource CardBorder}" BorderThickness="1" />
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource LinkButton}" Content="Close" Click="Cancel_Click" Margin="0,0,12,0" AutomationProperties.Name="Close without result" FontSize="12" />
                    <Button Style="{StaticResource BaseButton}" Content="SKIP" Click="Skip_Click" Margin="0,0,10,0" MinWidth="90" Height="42" FontSize="13" />
                    <Button Style="{StaticResource FailButton}" Content="FAIL" Click="Fail_Click" Margin="0,0,10,0" MinWidth="130" Height="42" FontSize="14" FontWeight="Bold" />
                    <Button Style="{StaticResource PassButton}" Content="PASS" Click="Pass_Click" MinWidth="130" Height="42" FontSize="14" FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>


