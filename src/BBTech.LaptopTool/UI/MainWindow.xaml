<Window x:Class="BBTech.LaptopTool.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BBTech Laptop Tool" MinWidth="760" MinHeight="430"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI" Foreground="{StaticResource TextPrimary}" Icon="/Assets/bbtech.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header (logo colours) -->
        <Border Background="{StaticResource HeaderGradient}">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Style="{StaticResource BaseButton}" Background="#1FFFFFFF" BorderBrush="#40FFFFFF"
                            Foreground="White" Padding="12,4" MinHeight="34" Margin="0,0,14,0" Click="Back_Click" Visibility="Collapsed"
                            ToolTip="Back to start screen" AutomationProperties.Name="Home">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72B;" Foreground="White" VerticalAlignment="Center" FontSize="13" />
                            <TextBlock Text="Home" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Image Source="/Assets/Branding/logo-tile-256.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="BBTech Laptop Tool logo" />
                    <TextBlock Text="BBTech Laptop Tool" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                    <TextBlock x:Name="SectionTitle" Foreground="#A9D8FF" FontSize="18" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="AdminBadge" CornerRadius="12" Background="#3316A34A" BorderBrush="#8016A34A" BorderThickness="1"
                            Padding="10,4" Margin="0,0,10,0" ToolTip="Running with Administrator privileges (Full hardware diagnostics enabled)"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7EF;" Foreground="#86EFAC" VerticalAlignment="Center" FontSize="12" />
                            <TextBlock Text="Administrator" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="RunAdminButton" Style="{StaticResource BaseButton}" Background="#D97706" BorderBrush="#B45309"
                            Foreground="White" Padding="10,4" MinHeight="30" Margin="0,0,10,0" Click="RunAdmin_Click"
                            ToolTip="Click to restart with Administrator privileges for full hardware and SSD SMART diagnostic access"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7EF;" Foreground="White" VerticalAlignment="Center" FontSize="12" />
                            <TextBlock Text="Run as Administrator" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="UsbChip" CornerRadius="12" Background="#26FFFFFF" Padding="12,5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE88E;" Foreground="#CFE8FF" VerticalAlignment="Center" />
                            <TextBlock x:Name="UsbText" Foreground="White" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl x:Name="Host" Grid.Row="1" Focusable="False" />
    </Grid>
</Window>
