<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BBTech.Api</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- BBTech.Core (shared lifecycle rules) targets .NET Framework 4.7.2; its pure logic runs unchanged on .NET 8. -->
    <NoWarn>$(NoWarn);NU1702</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BBTech.Core\BBTech.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BBTech.Api.Tests" />
  </ItemGroup>

</Project>
